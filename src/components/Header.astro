---
import { Image } from 'astro:assets';
import empresa from '../data/empresa.json';
import logo from '../assets/brand/logo-desentupidora-santo-andre.webp';

const whatsappUrl = `https://wa.me/${empresa.whatsapp}?text=${encodeURIComponent(
  'Olá! Gostaria de solicitar um orçamento.',
)}`;

const links = [
  { href: '/', label: 'Home' },
  { href: '/servicos', label: 'Serviços' },
  { href: '/areas-de-atendimento', label: 'Áreas de Atendimento' },
  { href: '/sobre/', label: 'Sobre' },
  { href: '/orcamento/', label: 'Orçamento' },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a
      href="/"
      class="shrink-0"
      aria-label={`${empresa.nome} — página inicial`}
    >
      <Image
        src={logo}
        alt={empresa.nome}
        width={220}
        height={147}
        format="webp"
        quality={80}
        densities={[1, 2]}
        class="h-[8.75rem] w-auto max-h-[140px]"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Menu principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-slate-700 transition hover:text-sky-700"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={whatsappUrl}
        class="inline-flex items-center justify-center rounded-md bg-emerald-700 px-3 py-2 text-sm font-semibold text-white transition hover:bg-emerald-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Solicitar orçamento pelo WhatsApp"
      >
        WhatsApp
      </a>

      <details class="relative lg:hidden">
        <summary
          class="flex cursor-pointer list-none items-center justify-center rounded-md border border-slate-300 px-3 py-2 text-sm font-medium text-slate-800"
          aria-label="Abrir menu"
        >
          Menu
        </summary>
        <nav
          class="absolute right-0 mt-2 w-56 rounded-md border border-slate-200 bg-white p-2 shadow-lg"
          aria-label="Menu mobile"
        >
          {
            links.map((link) => (
              <a
                href={link.href}
                class="block rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 hover:text-sky-700"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
