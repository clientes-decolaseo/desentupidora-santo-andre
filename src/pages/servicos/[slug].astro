---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Schema from '../../components/Schema.astro';
import PorQueEscolher from '../../components/PorQueEscolher.astro';
import CtaContato from '../../components/CtaContato.astro';
import empresa from '../../data/empresa.json';

export async function getStaticPaths() {
  const servicos = await getCollection('servicos');

  return servicos.map((servico) => ({
    params: { slug: servico.data.slug },
    props: { servico },
  }));
}

interface Props {
  servico: CollectionEntry<'servicos'>;
}

const { servico } = Astro.props;
const { Content } = await render(servico);

const outrosServicos = (await getCollection('servicos'))
  .filter((item) => item.data.slug !== servico.data.slug)
  .sort((a, b) => a.data.order - b.data.order);

const paginaUrl = new URL(`/servicos/${servico.data.slug}`, Astro.site).href;
const siteUrl = Astro.site?.href ?? 'https://desentupidorasantoandre.app.br';

const contexto = `neste atendimento de ${servico.data.title.toLowerCase()}`;
---

<BaseLayout title={servico.data.title} description={servico.data.description}>
  <Schema
    slot="schema"
    name={empresa.nome}
    telephone={empresa.telefone}
    areaServed={empresa.areasAtendidas}
    url={siteUrl}
    service={{
      name: servico.data.title,
      description: servico.data.description,
      url: paginaUrl,
    }}
  />

  <article>
    <header class="border-b border-slate-200 bg-white">
      <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-sky-700">
          Serviços
        </p>
        <h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
          {servico.data.title}
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">
          {servico.data.description}
        </p>
      </div>
    </header>

    <section class="border-b border-slate-200 bg-white" aria-label="Detalhes do serviço">
      <div class="prose-servico mx-auto max-w-3xl px-4 py-12 sm:px-6">
        <Content />
      </div>
    </section>

    <PorQueEscolher contexto={contexto} />

    <CtaContato
      titulo={`Precisa de ${servico.data.title.toLowerCase()}?`}
      texto="Chame no WhatsApp ou ligue agora para orçamento sem compromisso."
    />

    <section class="border-t border-slate-200 bg-white" aria-labelledby="outros-servicos-titulo">
      <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
        <h2 id="outros-servicos-titulo" class="text-2xl font-bold tracking-tight text-slate-900">
          Outros serviços
        </h2>
        <p class="mt-3 text-slate-600">
          Confira também os demais atendimentos da {empresa.nome}.
        </p>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            outrosServicos.map((item) => (
              <li>
                <a
                  href={`/servicos/${item.data.slug}`}
                  class="group block border-t border-slate-200 pt-4 transition"
                >
                  <span class="text-base font-semibold text-slate-900 transition group-hover:text-sky-700">
                    {item.data.title}
                  </span>
                  <span class="mt-1 block text-sm text-slate-600">{item.data.shortCopy}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .prose-servico :global(p) {
    margin-top: 1rem;
    line-height: 1.7;
    color: #475569;
  }

  .prose-servico :global(p:first-child) {
    margin-top: 0;
  }

  .prose-servico :global(img) {
    display: block;
    width: 100%;
    max-width: 800px;
    height: auto;
    margin: 1.5rem 0;
  }
</style>
