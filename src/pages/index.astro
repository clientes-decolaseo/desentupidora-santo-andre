---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Schema from '../components/Schema.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import empresa from '../data/empresa.json';
import faqs from '../data/faq-home.json';
import imagemConfianca from '../assets/servicos/equipe-trabalho-campo.jpg';

const servicos = (await getCollection('servicos')).sort(
  (a, b) => a.data.order - b.data.order,
);

const whatsappUrl = 'https://wa.me/5511949077562';
const telefoneUrl = 'tel:+5511949077562';

const confianca = [
  'Mais de 30 anos de experiência',
  'Atendimento em Santo André e região',
  'Orçamento sem compromisso',
  'Equipe qualificada e equipamentos próprios',
];

const passos = [
  {
    numero: '1',
    titulo: 'Chame no WhatsApp ou ligue',
    texto: 'Fale com a gente, descreva o problema e receba orientação imediata.',
  },
  {
    numero: '2',
    titulo: 'Receba o orçamento',
    texto: 'Informamos o valor com transparência, sem compromisso de fechar na hora.',
  },
  {
    numero: '3',
    titulo: 'Resolvemos o entupimento',
    texto: 'A equipe vai até você e executa o serviço com agilidade e cuidado.',
  },
];
---

<BaseLayout
  title="Desentupidora em Santo André com Mais de 30 Anos de Experiência"
  description={empresa.descricao}
>
  <Schema
    slot="schema"
    name={empresa.nome}
    telephone={empresa.telefone}
    areaServed={empresa.areasAtendidas}
    url={Astro.site?.href ?? 'https://desentupidorasantoandre.app.br'}
  />

  <!-- Hero -->
  <section
    class="relative overflow-hidden border-b border-slate-200 bg-[linear-gradient(160deg,#0c4a6e_0%,#075985_42%,#0f172a_100%)] text-white"
    aria-labelledby="hero-titulo"
  >
    <div
      class="pointer-events-none absolute inset-0 opacity-40"
      style="background-image: radial-gradient(circle at 20% 20%, rgba(56,189,248,0.35), transparent 42%), radial-gradient(circle at 80% 0%, rgba(14,165,233,0.25), transparent 35%);"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:py-28">
      <p class="hero-reveal text-sm font-semibold uppercase tracking-[0.18em] text-sky-200">
        {empresa.nome}
      </p>
      <h1
        id="hero-titulo"
        class="hero-reveal mt-4 max-w-4xl text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl"
        style="animation-delay: 80ms"
      >
        Desentupidora em Santo André com Mais de 30 Anos de Experiência
      </h1>
      <p
        class="hero-reveal mt-5 max-w-2xl text-lg leading-relaxed text-sky-50/95 sm:text-xl"
        style="animation-delay: 160ms"
      >
        Atendimento rápido, orçamento sem compromisso e equipe qualificada para
        resolver qualquer entupimento em Santo André e região.
      </p>

      <div
        class="hero-reveal mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap"
        style="animation-delay: 240ms"
      >
        <a
          href={whatsappUrl}
          class="inline-flex items-center justify-center rounded-md bg-emerald-700 px-6 py-3 text-base font-semibold text-white transition hover:bg-emerald-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700"
          target="_blank"
          rel="noopener noreferrer"
        >
          Chamar no WhatsApp
        </a>
        <a
          href={telefoneUrl}
          class="inline-flex items-center justify-center rounded-md border border-white/40 bg-white/10 px-6 py-3 text-base font-semibold text-white backdrop-blur transition hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          Ligar Agora — (11) 94907-7562
        </a>
      </div>
    </div>
  </section>

  <!-- Bloco de Confiança -->
  <section class="border-b border-slate-200 bg-slate-50" aria-labelledby="confianca-titulo">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <h2 id="confianca-titulo" class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Por que confiar na nossa equipe
      </h2>
      <p class="mt-3 max-w-2xl text-slate-600">
        Atendimento direto, experiência local e foco em resolver o problema com clareza.
      </p>
      <Image
        src={imagemConfianca}
        alt="Equipe uniformizada em trabalho de campo, movendo blocos de concreto com alavanca"
        width={768}
        height={511}
        format="webp"
        quality={80}
        sizes="(min-width: 48rem) 768px, calc(100vw - 2rem)"
        class="mt-8 w-full max-w-3xl h-auto"
      />
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          confianca.map((item) => (
            <li class="border-l-2 border-sky-600 pl-4 text-base font-medium text-slate-800">
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Grid de Serviços -->
  <ServiceGrid
    servicos={servicos}
    titulo="Serviços de desentupimento"
    descricao="Soluções para pia, ralo, vaso, caixa de gordura, fossa, rede de esgoto e hidrojateamento."
  />

  <!-- Como Funciona -->
  <section class="border-b border-slate-200 bg-slate-50" aria-labelledby="como-funciona-titulo">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <h2 id="como-funciona-titulo" class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Como funciona
      </h2>
      <p class="mt-3 max-w-2xl text-slate-600">
        Do primeiro contato à solução do entupimento, o processo é simples e transparente.
      </p>

      <ol class="mt-10 grid gap-8 md:grid-cols-3">
        {
          passos.map((passo) => (
            <li>
              <p class="text-sm font-semibold uppercase tracking-wider text-sky-700">
                Passo {passo.numero}
              </p>
              <h3 class="mt-2 text-xl font-semibold text-slate-900">{passo.titulo}</h3>
              <p class="mt-2 text-slate-600">{passo.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-b border-slate-200 bg-white" aria-labelledby="faq-titulo">
    <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
      <h2 id="faq-titulo" class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Perguntas frequentes
      </h2>
      <p class="mt-3 text-slate-600">
        Tire dúvidas rápidas antes de solicitar o atendimento.
      </p>

      <div class="mt-8 divide-y divide-slate-200 border-y border-slate-200">
        {
          faqs.map((faq) => (
            <details class="group py-4">
              <summary class="cursor-pointer list-none text-left text-base font-semibold text-slate-900 marker:content-none [&::-webkit-details-marker]:hidden">
                <span class="flex items-start justify-between gap-4">
                  <span>{faq.pergunta}</span>
                  <span
                    class="mt-0.5 shrink-0 text-sky-700 transition group-open:rotate-45"
                    aria-hidden="true"
                  >
                    +
                  </span>
                </span>
              </summary>
              <p class="mt-3 pr-8 text-slate-600">{faq.resposta}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA Final -->
  <section
    class="bg-[linear-gradient(135deg,#0f172a_0%,#075985_100%)] text-white"
    aria-labelledby="cta-final-titulo"
  >
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 id="cta-final-titulo" class="max-w-2xl text-3xl font-bold tracking-tight sm:text-4xl">
        Precisa de desentupidora em Santo André agora?
      </h2>
      <p class="mt-4 max-w-2xl text-lg text-sky-100">
        Fale com a {empresa.nome} e resolva o entupimento com atendimento rápido e orçamento sem compromisso.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={whatsappUrl}
          class="inline-flex items-center justify-center rounded-md bg-emerald-700 px-6 py-3 text-base font-semibold text-white transition hover:bg-emerald-800"
          target="_blank"
          rel="noopener noreferrer"
        >
          Chamar no WhatsApp
        </a>
        <a
          href={telefoneUrl}
          class="inline-flex items-center justify-center rounded-md border border-white/40 px-6 py-3 text-base font-semibold text-white transition hover:bg-white/10"
        >
          Ligar Agora — (11) 94907-7562
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-reveal {
    animation: hero-reveal 0.7s ease-out both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal {
      animation: none;
    }
  }
</style>
