---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Schema from '../../components/Schema.astro';
import AreaGrid from '../../components/AreaGrid.astro';
import CtaContato from '../../components/CtaContato.astro';
import empresa from '../../data/empresa.json';

const areas = await getCollection('areas');

const metaDescription =
  'Áreas de atendimento da Desentupidora Rápida Santo André: Santo André, São Bernardo do Campo e Diadema. Orçamento sem compromisso.';

const siteUrl = Astro.site?.href ?? 'https://desentupidoraemsantoandre.app.br';
const paginaUrl = new URL('/areas-de-atendimento/', Astro.site).href;
---

<BaseLayout
  title="Áreas de Atendimento | Desentupidora Rápida Santo André"
  description={metaDescription}
>
  <Schema
    slot="schema"
    name={empresa.nome}
    telephone={empresa.telefone}
    areaServed={empresa.areasAtendidas}
    url={siteUrl}
    service={{
      name: 'Desentupimento no ABC Paulista',
      description: metaDescription,
      url: paginaUrl,
    }}
  />

  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-sky-700">
        Cobertura
      </p>
      <h1 class="mt-3 max-w-4xl text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
        Áreas de Atendimento
      </h1>
      <p class="mt-5 max-w-2xl text-lg text-slate-600">
        {metaDescription}
      </p>
    </div>
  </header>

  <AreaGrid areas={areas} />

  <CtaContato
    titulo="Atendemos sua região?"
    texto="Chame no WhatsApp ou ligue e informe seu bairro para orçamento sem compromisso."
  />
</BaseLayout>
